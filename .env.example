# ---------------------------------------------------------------------------
# MacroStack AI — shared environment template
# Copy to .env.local on each machine:  cp .env.example .env.local
# ---------------------------------------------------------------------------

# --- Shared System & Server Config ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000


# --- Teammate 2: Vision Auditor & MCP Config ---
#
# NOTE: the original task plan specified OPENAI_API_KEY / GPT-4o Vision.
# We switched to Google Gemini because GPT-4o Vision is paid. Gemini exposes an
# OpenAI-COMPATIBLE endpoint, so the `openai` npm SDK is still used unchanged —
# only the base URL and model name differ. That also means switching providers
# (Groq, OpenRouter, OpenAI) is a config change, not a code change.
#
# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
# (Note: a Google AI Pro consumer subscription does NOT grant API quota —
#  the AI Studio key has its own separate free tier.)
#
# LEAVE VISION_API_KEY BLANK TO RUN OFFLINE. With no key the label auditor
# falls back to deterministic mock audits, so the app is fully runnable with
# zero setup. Reasoning logs always state which mode produced them.
VISION_API_KEY=
VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
VISION_MODEL=gemini-3.6-flash

# MCP server is mounted in-app by the Next.js route handler at /api/mcp
MCP_VISION_SERVER_URL=http://localhost:3000/api/mcp

# Paces the /api/optimize?stream=1 log stream, in milliseconds per log.
# Offline mock audits do no I/O, so the optimizer finishes in under a
# millisecond and the reasoning feed pops all at once instead of animating.
# Set to ~150 for a demo. Leave 0 in production — with a real vision key each
# label audit is already a network round-trip.
AGENT_LOG_DELAY_MS=0


# --- Teammate 3: Prava & Automation Config ---
PRAVA_API_KEY=prv_test_...
PRAVA_ENVIRONMENT=sandbox # sandbox | production
PRAVA_MERCHANT_WEBHOOK_SECRET=whsec_...
PLAYWRIGHT_HEADLESS=true
