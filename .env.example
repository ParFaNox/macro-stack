# ---------------------------------------------------------------------------
# MacroStack AI — shared environment template
# Copy to .env.local on each machine:  cp .env.example .env.local
# ---------------------------------------------------------------------------

# --- Shared System & Server Config ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000


# --- Teammate 2: Vision Auditor & MCP Config ---
#
# Provider-neutral. The `openai` SDK talks to whatever VISION_BASE_URL points
# at, so switching providers is env only — no code change.
#
# DEFAULT: OpenAI gpt-4o. The hackathon supplies $100 of OpenAI credits and
# there is an award for OpenAI usage, so this is the intended setup.
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o
#
# FREE ALTERNATIVE — Google Gemini (no billing at all).
# Key: https://aistudio.google.com/apikey  (a Google AI Pro consumer plan does
# NOT grant API quota; AI Studio has its own free tier.)
# Free tier is 20 requests/minute and a 5-ingredient stack fires 15 audits, so
# run `npm run warm-labels` before demoing on it.
#   VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   VISION_MODEL=gemini-3.5-flash
#
# LEAVE VISION_API_KEY BLANK TO RUN OFFLINE. With no key the auditor falls back
# to deterministic mock audits, so the app is fully runnable with zero setup.
# Reasoning logs always state which mode produced them.
#
# Caps retry attempts on a rate-limited vision call. Set 1 to disable retries.
VISION_MAX_ATTEMPTS=2

# MCP server is mounted in-app by the Next.js route handler at /api/mcp
MCP_VISION_SERVER_URL=http://localhost:3000/api/mcp

# Paces the /api/optimize?stream=1 log stream, in milliseconds per log.
# Offline mock audits do no I/O, so the optimizer finishes in under a
# millisecond and the reasoning feed pops all at once instead of animating.
# Set to ~150 for a demo. Leave 0 in production — with a real vision key each
# label audit is already a network round-trip.
AGENT_LOG_DELAY_MS=0


# --- Prava: virtual cards & checkout automation ---
# Sandbox keys from https://dashboard.prava.space (no business verification
# needed for sandbox). Leave PRAVA_SECRET_KEY blank to run in SIMULATED mode —
# the pipeline still works end to end and every result is labelled SIMULATED.
PRAVA_SECRET_KEY=
NEXT_PUBLIC_PRAVA_PUBLISHABLE_KEY=
PRAVA_ENVIRONMENT=sandbox # sandbox | production
PRAVA_API_BASE=https://sandbox.api.prava.space/v1

# Merchant URL sent to Prava when creating a session. Must be a reachable
# https origin — an http://localhost value is rejected by their tokenization
# provider with PROVISION_ERROR 403.
PRAVA_MERCHANT_URL=https://nutrimart-demo.example.com

# Passkey guardrail. Unset = SIMULATED (binds amount + merchant, single-use,
# but no proof of human presence). Set to `webauthn` once a credential registry
# is wired; until then that mode deliberately refuses to mint.
PASSKEY_MODE=
PASSKEY_SIM_SECRET=

# false = watch the checkout happen in a visible browser (good for demos)
PLAYWRIGHT_HEADLESS=true

# --- Optional: live retail product search (Bright Data) ---
# Without these the optimizer ranks the built-in seed catalog, which always
# works offline. With them, it searches real retailer listings for whatever a
# visitor types and normalises the results into the same shape. Any failure —
# missing key, network, quota, unparseable response — falls back to the seed
# catalog and says so in the reasoning logs.
# Set PRODUCT_SEARCH_PROVIDER=seed to force the offline catalog even when keys exist.
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=
PRODUCT_SEARCH_PROVIDER=

# --- Senso: brand trust / discovery signal ---
# Ranks brands on third-party verification, not just price. Free $100 of
# credits, no card: https://docs.senso.ai
# Leave blank to run without it — brands fall back to a neutral, clearly
# labelled UNVERIFIED score rather than a fake one.
# Seed the knowledge base once with:  npm run ingest-trust
SENSO_API_KEY=
SENSO_API_BASE=https://apiv2.senso.ai/api/v1
# Model that scores Senso's answer. Defaults to VISION_MODEL. Worth pointing at
# a smaller model: this is a text-only task, and providers meter quota per
# model, so sharing the vision bucket makes label audits and trust scoring
# starve each other.
TRUST_MODEL=
